{
  "name": "3d-slot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lab": "vite --open \"/?dev=lab\"",
    "gallery": "vite --open \"/?dev=gallery\"",
    "capture": "node tools/capture/shot.mjs",
    "qa:review": "node tools/qa/animation-review.mjs --url http://localhost:5173/",
    "qa:approval": "vite build && node tools/qa/approval.mjs --serve --port 4173",
    "spine:gen": "${PYTHON:-python3} tools/spine/gen.py",
    "spine:validate": "node tools/spine/validate.mjs",
    "spine:pack": "${PYTHON:-python3} tools/spine/pack.py",
    "spine:blur": "${PYTHON:-python3} tools/spine/make_blur.py",
    "spine:export": "tools/spine/export.sh",
    "spine:preview": "node tools/spine/preview/serve.mjs --port 5231",
    "spine:capture": "node tools/spine/preview/capture.mjs",
    "spine:demo": "tools/spine/examples/demo_symbol/build.sh",
    "spine:test": "tools/spine/test/run.sh",
    "blender:symbol": "tools/blender/run.sh render_symbol",
    "blender:turntable": "tools/blender/run.sh turntable",
    "blender:cleanup": "tools/blender/run.sh cleanup_mascot",
    "blender:actions": "tools/blender/run.sh build_actions",
    "blender:export": "tools/blender/run.sh export_glb",
    "anim:check": "${PYTHON:-python3} tools/blender/build_actions.py --check",
    "gltf:optimize": "bash tools/gltf/optimize.sh",
    "gltf:budget": "node tools/gltf/budget.mjs",
    "test:blender": "bash tools/blender/tests/run_tests.sh",
    "licence:audit": "node tools/licence/audit.mjs",
    "gen:higgsfield": "node tools/gen/higgsfield.mjs",
    "gen:nbp": "${PYTHON:-python3} tools/gen/nbp.py",
    "gen:scenario": "${PYTHON:-python3} tools/gen/scenario.py",
    "gen:sfx": "node tools/audio/gen-sfx.mjs",
    "gen:music": "node tools/audio/gen-music.mjs",
    "matte": "${PYTHON:-python3} tools/matte/outline_matte.py",
    "matte:variants": "${PYTHON:-python3} tools/matte/variants.py",
    "video:key": "bash tools/video/key_video.sh",
    "video:stacked": "bash tools/video/stacked_alpha.sh",
    "audio:master": "bash tools/audio/master.sh",
    "audio:sprite": "node tools/audio/sprite.mjs",
    "assets:pack": "node tools/assets/pack.mjs"
  },
  "dependencies": {
    "@esotericsoftware/spine-pixi-v8": "4.3.13",
    "@pixi/sound": "^6.0.1",
    "gsap": "3.15.0",
    "pixi-filters": "^6.1.5",
    "pixi.js": "8.21.0",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@assetpack/core": "1.7.0",
    "@esotericsoftware/spine-core": "4.3.13",
    "@gltf-transform/cli": "4.5.0",
    "@gltf-transform/core": "4.5.0",
    "@resvg/resvg-js": "2.6.2",
    "@tweakpane/core": "^2.0.5",
    "@types/node": "^22.20.4",
    "@types/three": "^0.186.0",
    "playwright": "1.63.0",
    "tweakpane": "^4.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "@ffmpeg-installer/linux-x64",
      "esbuild"
    ]
  }
}
