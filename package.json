{
  "name": "3d-slot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lab": "vite --open \"/?dev=lab\"",
    "gallery": "vite --open \"/?dev=gallery\"",
    "capture": "node tools/capture/shot.mjs",
    "qa:review": "node tools/qa/animation-review.mjs --url http://localhost:5173/",
    "qa:approval": "vite build && node tools/qa/approval.mjs --serve --port 4173"
  },
  "dependencies": {
    "@esotericsoftware/spine-pixi-v8": "4.3.13",
    "@pixi/sound": "^6.0.1",
    "gsap": "3.15.0",
    "pixi-filters": "^6.1.5",
    "pixi.js": "8.21.0",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@assetpack/core": "1.7.0",
    "@esotericsoftware/spine-core": "4.3.13",
    "@gltf-transform/cli": "4.5.0",
    "@gltf-transform/core": "4.5.0",
    "@resvg/resvg-js": "2.6.2",
    "@tweakpane/core": "^2.0.5",
    "@types/node": "^22.20.4",
    "@types/three": "^0.186.0",
    "playwright": "1.63.0",
    "tweakpane": "^4.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "@ffmpeg-installer/linux-x64",
      "esbuild"
    ]
  }
}
