{
  "$comment": "Machine-readable copy of docs/ANIMATION_CONTRACT.md sections 2-4, shared by tools/spine/gen.py (defaults) and tools/spine/validate.mjs (rules). When the doc changes, change this file in the same PR. All frames are at 30 fps; lengths are skeleton units (@2x px).",
  "fps": 30,
  "spineVersion": "4.3.23",
  "referenceScale": 100,
  "imagesPath": "../../art/source/spine/images/",
  "canvasPx": 360,
  "cellPx": 300,
  "boneNames": {
    "fixed": ["root", "squash", "body"],
    "prefixes": ["ctrl_", "ik_", "phys_", "face_", "fx_"],
    "pattern": "^[a-z][a-z0-9_]*(_[LR])?$"
  },
  "budgets": { "bones": 30, "meshVertices": 250, "slots": 8, "clipping": 0 },
  "constraintOrder": ["ik", "transform", "physics", "slider"],
  "physics": {
    "defaults": { "f": 3.5, "zeta": 0.25, "mass": 1, "inertia": 0.6, "fps": 60, "limit": 12000, "rotate": 1 },
    "presets": {
      "floppy": { "f": 3.0, "zeta": 0.2 },
      "default": { "f": 3.5, "zeta": 0.25 },
      "stiff": { "f": 4.0, "zeta": 0.3 },
      "jelly": { "f": 5.0, "zeta": 0.3 }
    },
    "minLimit": 10500,
    "editorDefault": { "strength": 100, "damping": 0.85 }
  },
  "events": {
    "land_impact": {},
    "win_peak": {},
    "explode_burst": {},
    "explode_done": {},
    "sfx": { "string": "" },
    "vfx": { "string": "" },
    "shake": { "float": 0 }
  },
  "fxIds": [
    "fx_explode", "fx_dust", "fx_land_puff", "fx_sparkle", "fx_coins", "fx_confetti", "fx_spot_spark", "fx_scatter",
    "fx_shake", "fx_flash", "fx_coin_shower", "fx_title_shine", "fx_shockwave", "fx_lightning", "fx_neon_flicker",
    "fx_trail", "fx_smoke_bg", "fx_poof", "fx_smoke", "fx_explosion_big"
  ],
  "animations": {
    "idle":               { "loop": true,  "frames": [60, 120], "required": ["high", "special"], "events": [] },
    "land":               { "loop": false, "frames": [9, 15],   "required": ["high", "special"], "events": ["land_impact"], "endsAtSetup": true, "inCell": true,
                            "squash": { "bone": "squash", "sy": [0.83, 0.87], "gate": [0.80, 0.88], "volumeTol": 0.03 } },
    "win":                { "loop": false, "frames": [18, 27],  "required": ["high", "special"], "events": ["win_peak"], "endsAt": "win_loop" },
    "win_loop":           { "loop": true,  "frames": [30, 60],  "required": ["high", "special"], "events": [] },
    "anticipation":       { "loop": true,  "frames": [12, 24],  "required": ["special"], "events": [] },
    "anticipation_intro": { "loop": false, "frames": [6, 12],   "required": [], "events": [], "endsAt": "anticipation" },
    "anticipation_out":   { "loop": false, "frames": [5, 10],   "required": [], "events": [], "endsAtSetup": true },
    "explode":            { "loop": false, "frames": [9, 18],   "required": ["high", "special"], "events": ["explode_burst", "explode_done"], "endsAlpha0": true,
                            "eventFrames": { "explode_burst": { "target": [2, 3], "hard": [1, 5] }, "explode_done": { "fromEnd": 2 } } },
    "appear":             { "loop": false, "frames": [6, 12],   "required": [], "events": [], "endsAtSetup": true },
    "blur":               { "loop": true,  "frames": [1, 2],    "required": ["high", "special"], "events": [] },
    "dim":                { "loop": false, "frames": [0, 30],   "required": [], "events": [], "overlay": 1 },
    "blink":              { "loop": false, "frames": [3, 6],    "required": [], "events": [], "overlay": 2 },
    "fx_glow":            { "loop": true,  "frames": [1, 120],  "required": [], "events": [], "overlay": 1 }
  },
  "runtimeAliases": {
    "$comment": "Legacy runtime names. src/symbols/SpinePool.ts (SPINE_EVENT / SPINE_ANIM) now accepts both these and the contract names, so new rigs do not need them; gen.py emits them only with compat.runtime_aliases: true (older runtimes).",
    "animations": { "anticipation_loop": "anticipation" },
    "events": { "impact": "land_impact", "burst": "explode_burst" }
  },
  "symbolKinds": {
    "H1": "high", "H2": "high", "H3": "high", "H4": "high",
    "W": "special", "S": "special",
    "L1": "royal", "L2": "royal", "L3": "royal", "L4": "royal", "L5": "royal"
  },
  "timing": {
    "winAnimDurationMs": 900,
    "explodeAnticipateMs": 80,
    "anticipationPulsePeriodMs": 520,
    "anticipationIntroMs": 300,
    "anticipationOutroMs": 250,
    "dimTint": "7f7f7f",
    "runtimeKick": 26,
    "$runtimeKickMax": "validator default: SYMBOL_TIMING.spine.physicsImpulse 26 x the largest land multiplier m = 1 + (1.6 * 1.15 - 1) * 0.45 = 1.378 (TIMING.land.weight.special x maxVelocityFactor, squashKnee), see SymbolRig.land",
    "runtimeKickMax": 36
  },
  "characters": {
    "$comment": "2D Spine characters (kind 'character'): docs/games/bass-drop/ANIMATION_SET.md section 5 (rigs, clips, events), section 10 (budgets) and section 12 CR-8. Read by spinegen/character.py (clip defaults, events, budgets) and validate.mjs --kind character. Symbol rules above do not apply to characters.",
    "anchor": [0.5, 1.0],
    "budgets": { "bones": 80, "slots": 40, "meshVertices": 2400, "physics": 12, "clipping": 0 },
    "atlas": { "pages": 1, "maxPage": 2048 },
    "physics": { "defaults": { "limit": 6000 }, "minLimit": 6000 },
    "boneNames": {
      "core": ["root", "hips", "spine", "chest", "neck", "head"],
      "limbs": ["upper_arm", "forearm", "hand", "thigh", "shin", "foot"],
      "words": ["jaw", "snout", "toothpick", "cooler", "cooler_lid", "pouch", "band", "cup", "mic", "tail"],
      "prefixes": ["ctrl_", "ik_", "phys_", "face_", "fx_", "txt_"]
    },
    "requiredBones": ["root", "hips", "spine", "chest", "neck", "head", "ctrl_look",
                      "upper_arm_L", "forearm_L", "hand_L", "thigh_L", "shin_L", "foot_L",
                      "upper_arm_R", "forearm_R", "hand_R", "thigh_R", "shin_R", "foot_R"],
    "springWords": ["tail", "jowl", "belly", "chain", "pouch", "cable", "toothpick"],
    "faceStates": { "eyes": ["open", "half", "closed", "wide"] },
    "proportions": { "headMax": 0.27, "excludeSlots": ["band", "cup_L", "cup_R", "cable", "mic", "toothpick"] },
    "tracks": { "body": 0, "overlay": 1, "face": 2, "look": 3 },
    "look": { "bone": "ctrl_look", "head": "look", "eyes": "look_eyes" },
    "requiredClips": ["idle", "idle_bored", "anticipation", "react_small", "win_big", "celebrate", "fs_trigger", "fs_end"],
    "clips": {
      "$comment": "Windows for any character (ANIMATION_CONTRACT 7.2 durations at 30 fps); a rig listed under `rigs` must match its exact frames.",
      "idle":             { "loop": true,  "frames": [120, 180], "track": 0 },
      "idle_bored":       { "loop": true,  "frames": [120, 240], "track": 0 },
      "anticipation":     { "loop": true,  "frames": [30, 60],   "track": 0 },
      "meter_heat":       { "loop": true,  "frames": [36, 72],   "track": 0 },
      "react_small":      { "loop": false, "frames": [36, 60],   "track": 0 },
      "react_point":      { "loop": false, "frames": [24, 45],   "track": 0 },
      "scratch":          { "loop": false, "frames": [24, 48],   "track": 0 },
      "bass_drop_charge": { "loop": false, "frames": [12, 18],   "track": 0 },
      "bass_drop":        { "loop": false, "frames": [24, 45],   "track": 0 },
      "win_big":          { "loop": false, "frames": [45, 75],   "track": 0 },
      "celebrate":        { "loop": true,  "frames": [60, 120],  "track": 0 },
      "fs_trigger":       { "loop": false, "frames": [60, 90],   "track": 0 },
      "fs_end":           { "loop": false, "frames": [45, 75],   "track": 0 },
      "wild_land_react":  { "loop": false, "frames": [9, 15],    "track": 1, "additive": true },
      "pouch_pump":       { "loop": false, "frames": [9, 15],    "track": 1, "additive": true },
      "blink":            { "loop": false, "frames": [3, 6],     "track": 2 }
    },
    "rigs": {
      "chr_gumbo": {
        "$comment": "ANIMATION_SET 5.1 (tempo 0.92, faces screen-right, near side R per ART_BIBLE bassDrop.mascots.gumbo.nearSide)",
        "attachments": { "mouth": ["closed_pick", "grin", "open", "roar"], "hand_R": ["open", "fist", "point"], "hand_L": ["open", "fist", "point", "lean"] },
        "clips": {
          "idle":            { "frames": 168, "loop": true,  "track": 0 },
          "idle_bored":      { "frames": 180, "loop": true,  "track": 0 },
          "anticipation":    { "frames": 36,  "loop": true,  "track": 0 },
          "meter_heat":      { "frames": 48,  "loop": true,  "track": 0 },
          "react_small":     { "frames": 45,  "loop": false, "track": 0 },
          "react_point":     { "frames": 30,  "loop": false, "track": 0 },
          "bass_drop":       { "frames": 36,  "loop": false, "track": 0 },
          "wild_land_react": { "frames": 12,  "loop": false, "track": 1 },
          "win_big":         { "frames": 60,  "loop": false, "track": 0, "events": [{ "name": "sfx", "string": "cooler_slam", "frame": 24 }] },
          "celebrate":       { "frames": 72,  "loop": true,  "track": 0 },
          "fs_trigger":      { "frames": 75,  "loop": false, "track": 0, "events": [{ "name": "sfx", "string": "cooler_slam", "frame": 36 }] },
          "fs_end":          { "frames": 54,  "loop": false, "track": 0 },
          "blink":           { "frames": 5,   "loop": false, "track": 2 }
        }
      },
      "chr_croak": {
        "$comment": "ANIMATION_SET 5.2 (tempo 1.06, faces screen-left, near side L). `scratch` is not in 5.2: the hand-only scratch without the sfx (the booth's `scratch` carries dj_scratch); react_small = scratch + nod + sfx.",
        "attachments": { "mouth": ["closed", "smile", "open", "O"], "hand_R": ["open", "point", "fist", "scratch", "press"], "hand_L": ["open", "point", "fist", "fader"] },
        "clips": {
          "idle":             { "frames": 144, "loop": true,  "track": 0 },
          "idle_bored":       { "frames": 150, "loop": true,  "track": 0 },
          "anticipation":     { "frames": 36,  "loop": true,  "track": 0 },
          "react_small":      { "frames": 36,  "loop": false, "track": 0, "events": [{ "name": "sfx", "string": "dj_scratch", "frame": 4 }] },
          "scratch":          { "frames": 36,  "loop": false, "track": 0 },
          "react_point":      { "frames": 30,  "loop": false, "track": 0 },
          "bass_drop_charge": { "frames": 15,  "loop": false, "track": 0, "endsAt": "bass_drop",
                                "events": [{ "name": "drop_hit", "frame": 14 }, { "name": "sfx", "string": "button_slam", "frame": 14 }] },
          "bass_drop":        { "frames": 30,  "loop": false, "track": 0 },
          "wild_land_react":  { "frames": 12,  "loop": false, "track": 1 },
          "pouch_pump":       { "frames": 12,  "loop": false, "track": 1 },
          "win_big":          { "frames": 60,  "loop": false, "track": 0, "events": [{ "name": "sfx", "string": "dj_scratch", "frame": 10 }] },
          "celebrate":        { "frames": 72,  "loop": true,  "track": 0 },
          "fs_trigger":       { "frames": 75,  "loop": false, "track": 0, "events": [{ "name": "sfx", "string": "mic_drop", "frame": 36 }] },
          "fs_end":           { "frames": 54,  "loop": false, "track": 0 },
          "blink":            { "frames": 5,   "loop": false, "track": 2 }
        }
      }
    }
  }
}
